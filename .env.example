# Leave DATABASE_URL unset to run against the in memory repository seeded from data/.
# Docker Compose sets this for the API container.
# DATABASE_URL=postgres://deal_notes:deal_notes@localhost:5432/deal_notes

# The optional extractor is off unless this is exactly "on".
# DEAL_NOTES_LLM_EXTRACTOR=off
# DEAL_NOTES_LLM_URL=
# DEAL_NOTES_LLM_MODEL=
# DEAL_NOTES_LLM_API_KEY=

# Port for the standalone GraphQL server used by Docker Compose.
# API_PORT=4000
