# The GraphQL API for local use with Docker Compose.
FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY server ./server
COPY scripts ./scripts
COPY data ./data

ENV NODE_ENV=production
ENV API_PORT=4000
EXPOSE 4000

CMD ["npm", "run", "api"]
